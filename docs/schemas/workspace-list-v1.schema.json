{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neotales.github.io/neoenv/workspace-list-v1.schema.json",
  "title": "NeoEnv workspace list document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "members"],
  "properties": {
    "schema_version": { "const": 1 },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "member", "path", "relative_path"],
        "properties": {
          "alias": {
            "description": "Alias that selects this member, or the empty string when the member declares none.",
            "type": "string"
          },
          "member": {
            "description": "Member path exactly as declared in the workspace configuration.",
            "type": "string"
          },
          "path": {
            "description": "Canonical absolute directory of the member.",
            "type": "string"
          },
          "relative_path": {
            "description": "Member directory relative to the workspace root.",
            "type": "string"
          }
        }
      }
    }
  }
}
